{
  "name": "shepy-pi",
  "version": "0.5.0",
  "description": "Pi extension bridge for Shepy agent history.",
  "type": "module",
  "keywords": [
    "pi-package",
    "shepy",
    "pi-extension"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
